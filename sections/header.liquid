<!-- =========================================
     STICKY JAVASCRIPT
     ========================================= -->

     <script>
(function() {

  function initFtMobileMenu() {

    var sectionId   = '{{ section.id }}';
    var hamburger   = document.getElementById('FtHamburger-'   + sectionId);
    var drawer      = document.getElementById('FtMobileDrawer-' + sectionId);
    var overlay     = document.getElementById('FtOverlay-'     + sectionId);
    var closeBtn    = document.getElementById('FtDrawerClose-'  + sectionId);

    if (!hamburger || !drawer || !overlay || !closeBtn) return;
    if (hamburger.dataset.ftMenuInit === 'true') return;
    hamburger.dataset.ftMenuInit = 'true';

    function openMenu() {
      overlay.classList.add('is-open');
      requestAnimationFrame(function() {
        overlay.classList.add('is-visible');
        drawer.classList.add('is-open');
      });
      drawer.setAttribute('aria-hidden', 'false');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      overlay.classList.remove('is-visible');
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(function() {
        overlay.classList.remove('is-open');
      }, 350);
    }

    hamburger.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);

    // Keyboard ESC
    document.addEventListener('keyup', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Submenu accordion
    drawer.querySelectorAll('.ft-drawer__nav-link[aria-expanded]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var li = btn.closest('li');
        var isExpanded = li.classList.contains('is-expanded');
        // Collapse all
        drawer.querySelectorAll('.ft-drawer__nav > ul > li').forEach(function(item) {
          item.classList.remove('is-expanded');
          var b = item.querySelector('[aria-expanded]');
          if (b) b.setAttribute('aria-expanded', 'false');
        });
        // Toggle clicked
        if (!isExpanded) {
          li.classList.add('is-expanded');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Theme editor support
    document.addEventListener('shopify:section:load', function(evt) {
      if (evt.target && evt.target.contains(hamburger)) {
        hamburger.dataset.ftMenuInit = 'false';
        initFtMobileMenu();
      }
    });

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFtMobileMenu);
  } else {
    initFtMobileMenu();
  }

})();
</script>



<script>
(function() {

  function initFashionTexStickyHeader() {

    var header = document.getElementById(
      'FashionTexHeader-{{ section.id }}'
    );

    var spacer = document.getElementById(
      'FashionTexHeaderSpacer-{{ section.id }}'
    );

    if (!header || !spacer) {
      return;
    }


    /*
      Prevent duplicate initialization
    */

    if (header.dataset.stickyInitialized === 'true') {
      return;
    }

    header.dataset.stickyInitialized = 'true';


    var headerTop = 0;
    var headerHeight = 0;


    /*
      Calculate original position
    */

    function calculatePosition() {

      /*
        Temporarily remove fixed mode
        so we can get the original document position.
      */

      var wasFixed = header.classList.contains(
        'fashion-header--fixed'
      );

      if (wasFixed) {

        header.classList.remove(
          'fashion-header--fixed'
        );

        spacer.classList.remove(
          'is-active'
        );

      }


      var rect = header.getBoundingClientRect();

      headerTop =
        rect.top +
        window.pageYOffset;

      headerHeight =
        header.offsetHeight;


      /*
        Restore fixed mode if necessary
      */

      if (wasFixed) {

        spacer.style.height =
          headerHeight + 'px';

        spacer.classList.add(
          'is-active'
        );

        header.classList.add(
          'fashion-header--fixed'
        );

      }

    }


    /*
      Check scroll position
    */

    function handleScroll() {

      var scrollTop =
        window.pageYOffset ||
        document.documentElement.scrollTop;


      /*
        When navbar reaches the top,
        lock it there.
      */

      if (scrollTop >= headerTop) {

        if (!header.classList.contains(
          'fashion-header--fixed'
        )) {

          headerHeight =
            header.offsetHeight;

          spacer.style.height =
            headerHeight + 'px';

          spacer.classList.add(
            'is-active'
          );

          header.classList.add(
            'fashion-header--fixed'
          );

        }

      } else {

        /*
          At the original position,
          return navbar to normal flow.
        */

        if (header.classList.contains(
          'fashion-header--fixed'
        )) {

          header.classList.remove(
            'fashion-header--fixed'
          );

          spacer.classList.remove(
            'is-active'
          );

          spacer.style.height = '0px';

        }

      }

    }


    /*
      Initial calculation
    */

    calculatePosition();


    /*
      Scroll listener
    */

    window.addEventListener(
      'scroll',
      handleScroll,
      {
        passive: true
      }
    );


    /*
      Recalculate on resize
    */

    window.addEventListener(
      'resize',
      function() {

        calculatePosition();

        handleScroll();

      }
    );


    /*
      Shopify Theme Editor support
    */

    document.addEventListener(
      'shopify:section:load',
      function(event) {

        if (
          event.target &&
          event.target.contains(header)
        ) {

          calculatePosition();
          handleScroll();

        }

      }
    );

  }


  /*
    Run after page loads
  */

  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initFashionTexStickyHeader
    );

  } else {

    initFashionTexStickyHeader();

  }

})();
</script>

