{% doc %}
  @prompt
    Create a premium, fully responsive Hero Banner section for the Shopify Dawn Theme for my ladies clothing brand "Fashion Tex", which sells ladies kurtis.
    
    IMPORTANT: The Desktop and Mobile hero images must be completely separate.
    
    Requirements:
    
    * Add a "Desktop Hero Image" setting where I can upload a desktop banner image.
    * Add a "Mobile Hero Image" setting where I can upload a completely different mobile image.
    * On desktop screens, show only the Desktop Hero Image.
    * On mobile screens, show only the Mobile Hero Image.
    * Do not simply crop or resize the desktop image for mobile.
    * Use responsive CSS/media queries to automatically switch between the two images.
    
    Theme Editor settings must include:
    
    * Desktop Hero Image
    * Mobile Hero Image
    * Heading
    * Subheading
    * Button Text
    * Button Link
    * Text Alignment: Left, Center, Right
    * Text Position: Top, Center, Bottom
    * Desktop Hero Height
    * Mobile Hero Height
    * Overlay Opacity
    * Optional rounded corners
    
    Design:
    
    * Premium and elegant ladies fashion style.
    * Modern, clean and luxurious appearance.
    * Suitable for a ladies kurti fashion brand.
    * High-quality typography.
    * Text should be clearly readable over the image.
    * Add a subtle optional overlay.
    * Smooth and responsive layout.
    * No unnecessary animations.
    
    Technical requirements:
    
    * Create a standalone Shopify OS 2.0 section.
    * Must be compatible with the free Shopify Dawn Theme.
    * Use Liquid, HTML and CSS.
    * Use minimal JavaScript only if absolutely necessary.
    * Use Shopify responsive image handling.
    * Make all important settings editable from the Shopify Theme Editor.
    * Do not modify existing Dawn theme files unnecessarily.
    * Provide the complete code ready to paste into a new .liquid section file.
    
    The most important requirement is that the Theme Editor provides TWO separate image upload fields: one for Desktop and one for Mobile, and the website automatically displays the correct image based on the visitor's screen size.
    , blue border line hatado bss, blue border line remove karo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-fashion-hero-{{ ai_gen_id }}{position:relative;display:block;width:100%;height:{{ block.settings.desktop_height }}px;overflow:hidden;border:0!important;outline:0!important;border-radius:{{ block.settings.corner_radius }}px;background:#242833}.ai-fashion-hero-{{ ai_gen_id }}__media,.ai-fashion-hero-{{ ai_gen_id }}__media img{position:absolute;inset:0;width:100%;height:100%;border:0!important;outline:0!important}.ai-fashion-hero-{{ ai_gen_id }}__media img{display:block;object-fit:cover;object-position:center}.ai-fashion-hero-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }});pointer-events:none}.ai-fashion-hero-{{ ai_gen_id }}__content{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:{{ block.settings.text_position }};align-items:{% if block.settings.text_alignment == 'left' %}flex-start{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};height:100%;width:100%;max-width:760px;margin:0 auto;padding:40px 6%;color:#fff;text-align:{{ block.settings.text_alignment }}}.ai-fashion-hero-{{ ai_gen_id }}__heading{margin:0 0 12px;color:#fff;font-family:var(--font-heading-family,serif);font-size:clamp(28px,4.5vw,64px);font-weight:500;line-height:1.08}.ai-fashion-hero-{{ ai_gen_id }}__subheading{max-width:560px;margin:0 0 26px;color:#fff;font-family:var(--font-body-family,sans-serif);font-size:clamp(15px,1.5vw,20px);line-height:1.5}.ai-fashion-hero-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 28px;border:0!important;outline:0;background:#fff;color:#121212;font-family:var(--font-body-family,sans-serif);font-size:14px;letter-spacing:.12em;line-height:1.2;text-decoration:none;text-transform:uppercase}.ai-fashion-hero-{{ ai_gen_id }}__button:hover{background:transparent;color:#fff}@media screen and (max-width:749px){.ai-fashion-hero-{{ ai_gen_id }}{height:{{ block.settings.mobile_height }}px}.ai-fashion-hero-{{ ai_gen_id }}__content{padding:28px 24px}}
{% endstyle %}
<div class="ai-fashion-hero-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}><div class="ai-fashion-hero-{{ ai_gen_id }}__media">{% if block.settings.desktop_image or block.settings.mobile_image %}<picture>{% if block.settings.mobile_image %}<source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url:width:1200 }}">{% endif %}{% if block.settings.desktop_image %}<img src="{{ block.settings.desktop_image | image_url:width:2400 }}" alt="{{ block.settings.desktop_image.alt | default:block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}">{% else %}<img src="{{ block.settings.mobile_image | image_url:width:1200 }}" alt="{{ block.settings.mobile_image.alt | default:block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}">{% endif %}</picture>{% endif %}</div><div class="ai-fashion-hero-{{ ai_gen_id }}__overlay"></div><div class="ai-fashion-hero-{{ ai_gen_id }}__content">{% if block.settings.heading != blank %}<h1 class="ai-fashion-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h1>{% endif %}{% if block.settings.subheading != blank %}<p class="ai-fashion-hero-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</p>{% endif %}{% if block.settings.button_text != blank and block.settings.button_link != blank %}<a class="ai-fashion-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_text | escape }}</a>{% endif %}</div></div>
{% schema %}{"name":"Fashion hero banner","settings":[{"type":"image_picker","id":"desktop_image","label":"Desktop hero image"},{"type":"image_picker","id":"mobile_image","label":"Mobile hero image"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_height","label":"Desktop hero height","min":300,"max":900,"step":25,"unit":"px","default":600},{"type":"range","id":"mobile_height","label":"Mobile hero height","min":300,"max":800,"step":25,"unit":"px","default":525},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":25},{"type":"range","id":"corner_radius","label":"Rounded corners","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"text","id":"heading","label":"Heading","default":"The new kurti edit"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Elegant silhouettes, thoughtfully made for every occasion."},{"type":"text","id":"button_text","label":"Button text","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"select","id":"text_position","label":"Text position","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"}],"presets":[{"name":"Fashion hero banner"}],"tag":null,"class":"fashion-hero-block"}{% endschema %}