{% doc %}
  @prompt
    Create a WhatsApp floating button for the Dawn theme with these requirements: fixed circular button at bottom-right corner, official WhatsApp green color (#25D366), white WhatsApp SVG icon inside, 56x56px on desktop and 52x52px on mobile, positioned 20px from right and bottom on desktop, 15px on mobile, subtle box-shadow, perfectly circular, smooth hover scale-up effect, tooltip saying "Chat with us on WhatsApp" on hover, stays visible while scrolling, opens https://wa.me/923XXXXXXXXX in a new tab on click, does not interfere with Dawn theme styles, uses only clean HTML/CSS/JavaScript with no external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    pointer-events: none;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    text-decoration: none;
    pointer-events: auto;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .ai-whatsapp-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid #121212;
    outline-offset: 3px;
  }

  .ai-whatsapp-{{ ai_gen_id }}__icon {
    display: block;
    width: 30px;
    height: 30px;
    fill: currentColor;
  }

  .ai-whatsapp-{{ ai_gen_id }}__tooltip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    width: max-content;
    max-width: 220px;
    padding: 8px 12px;
    border-radius: 4px;
    background: #121212;
    color: #ffffff;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link:hover .ai-whatsapp-{{ ai_gen_id }}__tooltip,
  .ai-whatsapp-{{ ai_gen_id }}__link:focus-visible .ai-whatsapp-{{ ai_gen_id }}__tooltip {
    opacity: 1;
    visibility: visible;
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-{{ ai_gen_id }}__link {
      right: 15px;
      bottom: 15px;
      width: 52px;
      height: 52px;
    }

    .ai-whatsapp-{{ ai_gen_id }}__icon {
      width: 28px;
      height: 28px;
    }
  }
{% endstyle %}

<whatsapp-floating-button-{{ ai_gen_id }} class="ai-whatsapp-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a
    class="ai-whatsapp-{{ ai_gen_id }}__link"
    href="https://wa.me/{{ block.settings.phone_number | remove: '+' | remove: ' ' | remove: '-' }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
  >
    <span class="ai-whatsapp-{{ ai_gen_id }}__tooltip" role="tooltip">{{ block.settings.tooltip_text }}</span>
    <svg class="ai-whatsapp-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.55 0 .24 5.31.24 11.84c0 2.09.55 4.13 1.59 5.93L.14 24l6.37-1.67a11.82 11.82 0 0 0 5.57 1.42h.01c6.53 0 11.84-5.31 11.84-11.84 0-3.17-1.23-6.15-3.41-8.43ZM12.09 21.7h-.01a9.85 9.85 0 0 1-5.02-1.37l-.36-.21-3.78.99 1.01-3.68-.23-.38a9.84 9.84 0 0 1-1.5-5.21C2.2 6.41 6.63 1.98 12.09 1.98c2.64 0 5.12 1.03 6.99 2.9a9.81 9.81 0 0 1 2.89 6.99c0 5.46-4.43 9.89-9.88 9.89Zm5.42-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.51-1.78-1.69-2.08-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
    </svg>
  </a>
</whatsapp-floating-button-{{ ai_gen_id }}>

<script>
  (function() {
    class WhatsappFloatingButton{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.setAttribute('data-whatsapp-ready', 'true');
      }
    }

    if (!customElements.get('whatsapp-floating-button-{{ ai_gen_id }}')) {
      customElements.define('whatsapp-floating-button-{{ ai_gen_id }}', WhatsappFloatingButton{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "WhatsApp button",
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "923XXXXXXXXX"
    },
    {
      "type": "text",
      "id": "tooltip_text",
      "label": "Tooltip text",
      "default": "Chat with us on WhatsApp"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "WhatsApp button"
    }
  ],
  "tag": null,
  "class": "whatsapp-floating-button-block"
}
{% endschema %}